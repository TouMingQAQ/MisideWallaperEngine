{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "miside-wallpaper-engine",
  "version": "0.0.1",
  "identifier": "com.toumingqaq.miside-wallpaper-engine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "miside-wallpaper-engine 动态壁纸",
        "width": 1280,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["binaries/ProcessAudioCapture.dll"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
